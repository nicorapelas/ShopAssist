{
  "expo": {
    "name": "ShopAssist",
    "slug": "ShopAssist",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/appIcon.png",
    "scheme": "shopassist",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo-text_bottom1-dark.png",
      "resizeMode": "contain",
      "backgroundColor": "#350d66"
    },
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.jacobscycles.shopassist",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ShopAssist uses the camera to scan product barcodes and photograph catalog items.",
        "NSPhotoLibraryUsageDescription": "ShopAssist uses your photo library to add product catalog images."
      }
    },
    "android": {
      "package": "com.jacobscycles.shopassist",
      "permissions": ["android.permission.CAMERA"],
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#350d66",
        "foregroundImage": "./assets/images/appIcon.png"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ShopAssist to scan product barcodes and photograph catalog items."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ShopAssist to choose product photos from your library.",
          "cameraPermission": "Allow ShopAssist to photograph products for the catalog."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-text_bottom1-dark.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#350d66",
          "dark": {
            "image": "./assets/images/logo-text_bottom1-dark.png",
            "backgroundColor": "#350d66"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
